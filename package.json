{
  "name": "proto",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/expo.cjs start --go",
    "android": "node scripts/expo.cjs start --go --android",
    "web": "node scripts/expo.cjs start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "export:android": "node scripts/expo.cjs export --platform android --output-dir dist/android",
    "export:web": "node scripts/expo.cjs export --platform web --output-dir dist/web",
    "check:dependencies": "node scripts/expo.cjs install --check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.19.1",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.1",
    "expo": "~57.0.23",
    "expo-font": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
